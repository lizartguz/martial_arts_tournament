APP_NAME="Combate Real"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=artsmartialdb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PAYMENT_PROOFS_DISK=local
QUEUE_CONNECTION=database

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=environmental
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=environmental
RABBITMQ_QUEUE=forecasts
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_TIMEOUT=5
RABBITMQ_READ_TIMEOUT=130
RABBITMQ_WRITE_TIMEOUT=5

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Credenciales de AWS / S3 (si el proyecto usa almacenamiento o servicios de Amazon)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Configuración del proveedor de IA usado por el proyecto
AI_PROVIDER=openai
AI_TIMEOUT=60

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# Variables públicas del frontend para Firebase Web (Analytics y Web Push)
VITE_APP_NAME="${APP_NAME}"
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Clave pública VAPID para Firebase Cloud Messaging Web Push en navegador
VITE_FIREBASE_VAPID_KEY=

# Minutos de validez de las URLs firmadas para imágenes privadas de avisos en la app móvil
NOTIFICATION_IMAGE_URL_TTL=15

# API Key general de servicios Google usados por el proyecto
GOOGLE_API_KEY=
# Credenciales de Libelula para cobros y renovaciones
LIBELULA_APP_KEY=
PAYMENT_ROUTE_CALLBACK=
PAYMENT_ROUTE=
# Credenciales privadas del backend para Firebase Cloud Messaging (envío server-to-server)
# Ruta relativa a storage/ o ruta absoluta del JSON privado de Firebase Admin SDK
FIREBASE_SDK=app/firebase/firebase-adminsdk.json
FIREBASE_ADDSCOPE=
FIREBASE_PETITION=

# Credenciales de Twilio para WhatsApp/API de mensajería
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
